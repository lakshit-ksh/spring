CREATE OR REPLACE PROCEDURE aggregate_scans_into_analytics()
LANGUAGE plpgsql
AS $$
DECLARE
    scan_record RECORD;
    analytics_record RECORD;
BEGIN
    -- Loop through each scan record
    FOR scan_record IN SELECT * FROM "scans" WHERE NOT aggregated LOOP
        -- Check if there's an existing analytics record for the qrCodeId and date
        SELECT * INTO analytics_record
        FROM "scan_daily_analytics"
        WHERE "qrCodeId" = scan_record."qrCodeId"
        AND date_trunc('day', scan_record."scannedAt") = date_trunc('day', scan_record."scannedAt");

        -- If no record exists, create a new one
        IF NOT FOUND THEN
            INSERT INTO "scan_daily_analytics" (
                "qrCodeId",
                "date",
                "totalScans",
                "uniqueScans",
                "deviceCounts",
                "browserCounts",
                "osCounts",
                "countryCounts",
                "cityCounts"
            )
            VALUES (
                scan_record."qrCodeId",
                date_trunc('day', scan_record."scannedAt"),
                1,
                1,
                jsonb_build_object(scan_record."deviceType", 1),
                jsonb_build_object(scan_record."browser", 1),
                jsonb_build_object(scan_record."os", 1),
                jsonb_build_object(scan_record."country", 1),
                jsonb_build_object(scan_record."city", 1)
            );
        ELSE
            -- If a record exists, update it
            UPDATE "scan_daily_analytics"
            SET
                "totalScans" = analytics_record."totalScans" + 1,
                "uniqueScans" = analytics_record."uniqueScans" + 1,
                "deviceCounts" = jsonb_set(
                    COALESCE(analytics_record."deviceCounts", '{}'::jsonb),
                    ARRAY[scan_record."deviceType"],
                    (COALESCE((analytics_record."deviceCounts"->>scan_record."deviceType")::int, 0) + 1)::text::jsonb,
                    true
                ),
                "browserCounts" = jsonb_set(
                    COALESCE(analytics_record."browserCounts", '{}'::jsonb),
                    ARRAY[scan_record."browser"],
                    (COALESCE((analytics_record."browserCounts"->>scan_record."browser")::int, 0) + 1)::text::jsonb,
                    true
                ),
                "osCounts" = jsonb_set(
                    COALESCE(analytics_record."osCounts", '{}'::jsonb),
                    ARRAY[scan_record."os"],
                    (COALESCE((analytics_record."osCounts"->>scan_record."os")::int, 0) + 1)::text::jsonb,
                    true
                ),
                "countryCounts" = jsonb_set(
                    COALESCE(analytics_record."countryCounts", '{}'::jsonb),
                    ARRAY[scan_record."country"],
                    (COALESCE((analytics_record."countryCounts"->>scan_record."country")::int, 0) + 1)::text::jsonb,
                    true
                ),
                "cityCounts" = jsonb_set(
                    COALESCE(analytics_record."cityCounts", '{}'::jsonb),
                    ARRAY[scan_record."city"],
                    (COALESCE((analytics_record."cityCounts"->>scan_record."city")::int, 0) + 1)::text::jsonb,
                    true
                )
            WHERE "qrCodeId" = scan_record."qrCodeId"
            AND date = date_trunc('day', scan_record."scannedAt");
        END IF;

        -- Mark the scan as aggregated
        UPDATE "scans"
        SET aggregated = TRUE
        WHERE id = scan_record.id;
    END LOOP;
END;
$$;
